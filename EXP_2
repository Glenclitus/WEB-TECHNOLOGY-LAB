<!DOCTYPE html>
<html>
<head>
    <title>Online Art Supplies Store</title>
</head>
<body bgcolor="#F8F4E8">
<center>
<table width="100%" bgcolor="#7A0C0C">
<tr>
<td align="center">
<font color="white">
<h1>ONLINE ART SUPPLIES STORE</h1>
</font>
</td>
</tr>
</table>
<br>
<img src="art.jpg" width="1500" height="250" alt="Art Banner">
</center>
<hr color="#D4AF37" size="3">
<form>
<fieldset>
<legend><font color="#7A0C0C"><h2>Customer Information</h2></font></legend>
<table cellpadding="10" bgcolor="white" border="1" bordercolor="#D4AF37">
<tr>
<td><b>Full Name</b></td>
<td><input type="text" placeholder="Enter your name" required></td>
</tr>
<tr>
<td><b>Email</b></td>
<td><input type="email" placeholder="Enter your email" required></td>
</tr>
<tr>
<td><b>Phone Number</b></td>
<td><input type="tel" placeholder="9876543210"></td>
</tr>
<tr>
<td><b>Age</b></td>
<td><input type="number" min="10" max="100"></td>
</tr>
<tr>
<td><b>Delivery Date</b></td>
<td><input type="date"></td>
</tr>
<tr>
<td><b>Quantity</b></td>
<td><input type="number" min="1" max="20" value="1"></td>
</tr>
</table>
</fieldset>
<br>
<fieldset>
<legend><font color="#7A0C0C"><h2>Product Selection</h2></font></legend>
<table width="100%" cellpadding="15" bgcolor="white" border="1" bordercolor="#D4AF37">
<tr align="center">
<td>
<img src="acry.jpg" width="120" height="120"><br><br>
<input type="checkbox"> Acrylic Paints
</td>
<td>
<img src="water.jpg" width="120" height="120"><br><br>
<input type="checkbox"> Water Colors
</td>
<td>
<img src="canvas.jpg" width="120" height="120"><br><br>
<input type="checkbox"> Canvas
</td>
<td>
<img src="brush.jpg" width="120" height="120"><br><br>
<input type="checkbox"> Brushes
</td>
<td>
<img src="marker.jpg" width="120" height="120"><br><br>
<input type="checkbox"> Marker Pens
</td>
</tr>
</table>
<br>
<b>Category :</b>
<select>
<option>Painting</option>
<option>Drawing</option>
<option>Sketching</option>
<option>Craft Supplies</option>
<option>Accessories</option>
</select>
<br><br>
<b>Preferred Brand :</b>
<input list="brands">
<datalist id="brands">
<option>Camel</option>
<option>Faber Castell</option>
<option>Brustro</option>
<option>Doms</option>
<option>Staedtler</option>
</datalist>
</fieldset>
<br>
<fieldset>
<legend><font color="#7A0C0C"><h2>Delivery Details</h2></font></legend>
<table bgcolor="white" border="1" bordercolor="#D4AF37" cellpadding="10">
<tr>
<td>
<b>Shipping Address</b>
<br><br>
<textarea rows="5" cols="60" placeholder="Enter your address"></textarea>
<br><br>
<b>Upload Reference Image</b>
<br><br>
<input type="file">
</td>
</tr>
</table>
</fieldset>
<br>
<fieldset>
<legend><font color="#7A0C0C"><h2>Payment Details</h2></font></legend>
<table bgcolor="white" border="1" bordercolor="#D4AF37" cellpadding="10">
<tr>
<td>
<input type="radio" name="payment"> UPI
<br><br>
<input type="radio" name="payment"> Credit / Debit Card
<br><br>
<input type="radio" name="payment"> Cash On Delivery
<br><br>
<br><br>
<input type="submit" value="PLACE ORDER">
<input type="reset" value="RESET">
</td>
</tr>
</table>
</fieldset>
</form>
<hr color="#D4AF37" size="3">
<center>
<table bgcolor="#7A0C0C" width="100%" cellpadding="10">
